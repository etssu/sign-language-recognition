QWidget {
    background-color: #EEF2F8;
    color: #15182D;
}

QPushButton#cameraButton {
    border: 1px solid;
    border-radius: 12px;

    background-color: #526B9F;
    color: white;
    font-weight: bold;

    padding: 10px 15px;
}

QPushButton#cameraButton:hover {
    background-color: #657FB5;
    color: white;
}

QPushButton#cameraButton:pressed {
    background-color: #3D507D;
}